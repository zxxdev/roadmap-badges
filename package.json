{
  "name": "roadmap-badges",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that computes a project's progress from a feature catalog and its test results.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "rollup --config rollup.config.js",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "all": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm bundle"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "sax": "^1.6.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.19.2",
    "@types/sax": "^1.2.7",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.7",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
